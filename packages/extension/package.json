{
  "name": "@omega.js/extension",
  "version": "0.57.0",
  "description": "OMEGA extension framework — build, test, and package Chrome/Firefox extensions (MV3)",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/vendor/config/index.js",
    "./gulp": "./dist/gulp/main.js",
    "./build": "./dist/build.js",
    "./test": "./dist/test/index.js",
    "./background": "./dist/background.js",
    "./content": "./dist/content.js",
    "./popup": "./dist/popup.js",
    "./sidepanel": "./dist/sidepanel.js",
    "./options": "./dist/options.js",
    "./page": "./dist/page.js",
    "./offscreen": "./dist/offscreen.js",
    "./lib/affiliatizer": "./dist/lib/affiliatizer.js",
    "./lib/extension": "./dist/lib/extension.js",
    "./lib/logger-lite": "./dist/lib/logger-lite.js",
    "./lib/messaging": "./dist/lib/messaging.js",
    "./cli": "./dist/cli-run.js",
    "./ensure-target": "./dist/commands/lib/ensure-target.js",
    "./migrate": "./dist/commands/lib/migrate.js"
  },
  "scripts": {
    "start": "npm run prepare:watch",
    "prepare": "node -e \"require('../devkit/tools/prepare-guard').run()\"",
    "prepare:watch": "node -e \"require('prepare-package/watch')()\"",
    "test": "node dist/cli-run.js test"
  },
  "bin": {
    "omega": "bin/omega",
    "omg": "bin/omg",
    "mgr": "bin/omega"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "preparePackage": {
    "input": "./src",
    "output": "./dist",
    "replace": {},
    "type": "copy",
    "hooks": {
      "after": [
        "node -e \"require('@omega.js/devkit/prepare-guard').rewire()\"",
        "node -e \"require('@omega.js/devkit/vendor')()\""
      ],
      "afterBlocking": true
    }
  },
  "omega": {
    "nodeRuntime": "24",
    "vendorAssets": [
      {
        "package": "@omega.js/web",
        "from": "core/css/tokens/_index.scss",
        "to": "assets/css/tokens/_index.scss"
      },
      {
        "package": "@omega.js/web",
        "from": "core/css/shell",
        "to": "assets/css/shell"
      },
      {
        "package": "@omega.js/web",
        "from": "core/css/core/_custom-font-awesome.scss",
        "to": "assets/css/core/_fontawesome.scss"
      },
      {
        "package": "@omega.js/web",
        "from": "themes",
        "to": "assets/themes"
      },
      {
        "package": "@omega.js/web",
        "from": "core/js/core/app-shell.js",
        "to": "assets/js/core/app-shell.js"
      },
      {
        "package": "@omega.js/web",
        "from": "core/js/libs/initialize-tooltips.js",
        "to": "assets/js/libs/initialize-tooltips.js"
      },
      {
        "package": "@omega.js/web",
        "from": "core/js/libs/recaptcha.js",
        "to": "assets/js/libs/recaptcha.js"
      },
      {
        "package": "@omega.js/devkit",
        "from": "src/test/fixtures/esm-only-package",
        "to": "vendor/devkit/test/fixtures/esm-only-package"
      }
    ]
  },
  "projectScripts": {
    "gulp": "gulp",
    "publish": "OMEGA_IS_PUBLISH=true npm run gulp -- publish"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "omega",
    "browser-extension",
    "chrome-extension",
    "firefox-extension",
    "edge-extension",
    "web-extension",
    "manifest-v3",
    "gulp",
    "sass",
    "esbuild"
  ],
  "author": "ITW Creative Works",
  "license": "Elastic-2.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@popperjs/core": "^2.11.8",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "fs-jetpack": "^5.1.0",
    "glob": "^13.0.6",
    "gulp-clean-css": "^4.3.0",
    "gulp-filter": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-responsive-modern": "^1.0.0",
    "gulp-sass": "^6.0.1",
    "itwcw-package-analytics": "^1.0.8",
    "json5": "^2.2.3",
    "lodash": "^4.18.1",
    "minimatch": "^10.2.5",
    "node-powertools": "^3.0.0",
    "sass": "^1.100.0",
    "@omega.js/client": "0.57.0",
    "wonderful-fetch": "^2.0.5",
    "wonderful-version": "^1.3.2",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "gulp": "^5.0.1"
  },
  "devDependencies": {
    "@omega.js/config": "*",
    "@omega.js/devkit": "*",
    "@omega.js/web": "*",
    "prepare-package": "^2.2.0",
    "puppeteer": "^24.43.1"
  }
}
