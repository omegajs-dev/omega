{
  "name": "@omega.js/config",
  "version": "0.1.0",
  "description": "The single omega.json5 config format for every OMEGA project type: loader, schema, validator, and the SHARED_SECTIONS enumeration omega-manager disperses from (private workspace package, vendored/bundled into frameworks at prepare time)",
  "private": true,
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./analytics-providers": "./src/analytics-providers.js",
    "./schema": "./src/schema.js",
    "./merge": "./src/merge.js",
    "./secrets": "./src/secrets.js",
    "./validate": "./src/validate.js",
    "./load": "./src/load.js",
    "./env": "./src/env.js",
    "./environment": "./src/environment.js",
    "./brand-host": "./src/brand-host.js",
    "./api-address": "./src/api-address.js",
    "./dev-facts": "./src/dev-facts.js",
    "./email-providers": "./src/email-providers.js",
    "./env-schema": "./src/env-schema.js",
    "./env-delivery": "./src/env-delivery.js",
    "./env-needs": "./src/env-needs.js",
    "./env-when": "./src/env-when.js",
    "./site-global": "./src/site-global.js",
    "./target-types": "./src/target-types.js",
    "./winback": "./src/winback.js"
  },
  "scripts": {
    "test": "node ../devkit/src/test/cli.js --isolation=process"
  },
  "dependencies": {
    "@omega.js/account": "*",
    "dotenv": "^17.4.2",
    "json5": "^2.2.3",
    "@omega.js/devkit": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "ITW Creative Works",
  "license": "Elastic-2.0"
}
