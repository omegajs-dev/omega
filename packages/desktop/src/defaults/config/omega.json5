// config/omega.json5: the single OMEGA config file (JSON5: comments + trailing commas OK).
//
// Shape: SHARED sections at the top level (identical spelling in every OMEGA project
// type: website, backend, extension, desktop), then a `targets` object whose KEY
// PRESENCE says which targets this brand enables and whose values hold target-scoped
// settings. Any shared key may also appear inside a target entry to override it for
// that surface only (e.g. a desktop-specific monitoring.providers.sentry.dsn
// under targets.desktop).
//
// Secrets NEVER live here: they live in .env. The validator hard-fails on
// secret-shaped keys (…Secret, …privateKey).
{
  brand: {
    id: 'myapp',
    name: 'MyApp',
    url: 'https://myapp.example',
    contact: { email: 'support@myapp.example' },
    images: {
      brandmark: '',
      wordmark:  '',
      icon:      'src/assets/icons/icon.png',
    },
  },

  // Where this brand's code and artifacts live (#883): ONE owner, and every repo
  // derives from `<brand.id>-<role>`: `<brand.id>-omega` (source),
  // `<brand.id>-releases` (the public artifact channel this app's updater
  // polls), `<brand.id>-<web target>` (a built site). No repo NAME is ever
  // typed. Uncomment and name the owner to address them.
  // repo: {
  //   provider: 'github',
  //   owner: 'MyOrg',
  // },

  monitoring: {
    providers: {
      sentry: {
        dsn: '',
      },
    },
  },

  // GA4 analytics. Measurement ID lives in config (not secret); the API secret
  // lives in `process.env.GOOGLE_ANALYTICS_SECRET` (matches @omega.js/backend convention) so
  // it's not committed. The build's esbuild `define` bakes the secret into
  // packaged builds at build time so production apps don't need .env at runtime.
  // client_id / user_id are uuidv5(deviceId/firebaseUid, projectId-namespace)
  // so the same human gets unified events across desktop + web + backend.
  analytics: {
    // Presence-driven: set `providers.google.id` to `G-XXXXXXXXXX` to enable analytics.
    // Empty string = analytics disabled (matches @omega.js/backend convention, no redundant enabled flag).
    providers: {
      google: {
        id: '',                               // 'G-XXXXXXXXXX' Measurement ID
      },
    },
  },

  // Payment: @omega.js/backend-shaped so the same product catalog can be referenced from backend
  // + desktop. The schema enforces publishableKey shape when set; everything else is
  // freeform so apps can extend per their needs without @omega.js/desktop caring. Leave empty until
  // you're ready to wire payments.
  payment: {
    providers: {
      stripe: { publishableKey: '' },
      paypal: { clientId:       '' },
    },
    products: [],
  },

  // App/cloud platform role (provider-discriminated). `config` is the Firebase web
  // SDK config: copy directly from Firebase Console → Project Settings → SDK setup
  // (Config option). Same shape every OMEGA target reads.
  // A config with no apiKey disables Firebase Auth (main's auth lib logs one plain skip line).
  cloud: {
    provider: 'firebase',
    config: {
      apiKey:            '',
      authDomain:        '',
      databaseURL:       '',
      projectId:         '',
      storageBucket:     '',
      messagingSenderId: '',
      appId:             '',
      measurementId:     '',
    },
  },

  // Appearance: the app's DEFAULT theme. 'system' follows the OS preference live;
  // 'light'/'dark' are explicit overrides. A user's runtime choice (omega.theme.set
  // or the [data-omega-theme-set] controls) persists in storage and wins over this on
  // every boot. See @omega.js/manager/docs/desktop/themes.md.
  theme: {
    appearance: 'system',
  },

  // ── Target-scoped config. Every key is a target NAME (the folder
  // targets/<name> in a brand monorepo) and every entry declares its framework
  // `type`. For a standalone desktop repo only the `desktop` entry exists; in a
  // brand monorepo the brand-level omega.json5 lists every declared target.
  targets: {
    desktop: {
      type: 'desktop',

      // App-level metadata: universal cross-platform fields. @omega.js/desktop auto-derives sensible
      // defaults from the BRAND: `appId` ← `certificates.providers.apple.bundleIdPrefix`
      // plus `brand.id` with its dashes as dots (`com.example` + `my-app` →
      // `com.example.my.app`), the same id the certificates service registers.
      // No prefix declared → reverse-domain of `brand.url`
      // (`https://foo.example.com` → `com.example.foo`; no url → `app.<brand.id>`),
      // `productName` ← `brand.name`, `copyright` ← `© <year>, <brand.name>`.
      // Override any of these explicitly only if you must.
      //
      // `category` is a generic high-level category. @omega.js/desktop maps it to per-platform values
      // (mac uses Apple's UTI strings, linux uses freedesktop categories). Allowed values:
      //   productivity (default) | developer-tools | utilities | media | social | network
      // Override the per-platform mapping in `platforms.<plat>.category` if you need
      // something specific. See @omega.js/manager/docs/desktop/installer-options.md for the full table.
      //
      // `copyright` accepts a `{YEAR}` token expanded at build time to the current year.
      // Default is `© {YEAR}, <brand.name>`. Set explicitly only to change the holder.
      app: {
        appId:           null,
        productName:     null,
        copyright:       null,                // null → `© {YEAR}, <brand.name>`
        category:        'productivity',
        languages:       ['en'],              // applied as mac.electronLanguages
        darkModeSupport: true,                // mac honors via NSRequiresAquaSystemAppearance; win/linux ignore
        // Icons are convention-only. Drop PNGs at:
        //   config/icons/global/<slot>.png       : universal default for all platforms
        //   config/icons/mac/<slot>.png          : macOS override (beats global)
        //   config/icons/windows/<slot>.png      : Windows override
        //   config/icons/linux/<slot>.png        : Linux override (otherwise falls back to global → windows)
        // Slots: icon, tray (mac+win+linux); dmg (mac-only).
        // Native size only: @omega.js/desktop downscales @1x variants from your @2x source automatically.
        // macOS tray must be 32×32; @omega.js/desktop renames the dist output to trayTemplate.png for the
        // OS dark-mode auto-inversion magic.
      },
      // What this app SHIPS, plus each platform's install knobs (#867). The
      // vocabulary is the client's: mac, windows, linux (never macos, never win).
      //
      // `formats` is the declaration: presence = enabled, every format below is
      // ON by default, and the only way to drop one is `false` (e.g.
      // `snap: false`). Per-format settings live inside the format. The keys
      // beside `formats` are install knobs that map onto the same
      // electron-builder concepts (`mac.target`, `win.target`, `linux.target`),
      // but @omega.js/desktop owns the actual target list so auto-update keeps
      // working (see @omega.js/manager/docs/desktop/installer-options.md for why). Each block exposes only
      // the knobs that exist for that platform: there is no cross-platform
      // analog for any of these.
      platforms: {
        mac: {
          // The disk image the site's /download/mac/dmg hands over. The
          // auto-update zip is not a format: electron-updater fetches it from
          // the feed and nobody links it, so the mac leg always builds it.
          formats: {
            dmg: {},
          },
          arch: ['universal'],   // universal binary (x64 + arm64 lipo'd), one .dmg/.zip for both
          // Entitlements override map. @omega.js/desktop ships sensible defaults (allow-jit,
          // allow-unsigned-executable-memory, disable-library-validation, network.client/server,
          // files.user-selected.read-write, allow-dyld-environment-variables). To override:
          //   - Set a key to a value to add/replace it (boolean, string, or array per Apple's plist spec)
          //   - Set a key to `null` to remove it from @omega.js/desktop's defaults
          // Output: dist/config/entitlements.mac.plist (auto-wired into electron-builder.yml).
          // Example: { 'com.apple.security.network.server': false, 'com.apple.security.device.audio-input': true }
          entitlements: {},
          // MAS (Mac App Store): STUBBED. Config is parsed but not yet implemented;
          // setting `enabled: true` triggers an audit warning. Real implementation lands
          // in a future release. Reference plists from a working MAS-published Electron app
          // are archived at <em>/src/defaults/_mas/ for the eventual implementation.
          mas: {
            enabled:             false,
            provisioningProfile: null,
            entitlements:        null,
            entitlementsInherit: null,
          },
        },
        windows: {
          // The one installer, at /download/windows/nsis. NSIS merges every
          // arch below into a single .exe.
          formats: {
            nsis: {},
          },
          arch: ['x64', 'ia32'],          // 64-bit + 32-bit (single multi-arch NSIS installer)
          oneClick:           true,        // no installer wizard, just installs immediately
          desktopShortcut:    true,
          startMenuShortcut:  true,
          runAfterFinish:     true,
          perMachine:         false,       // per-user install (required for oneClick:true)
          // Code-signing strategy. Picked at workflow time to drive runner selection +
          // job gating. See @omega.js/manager/docs/desktop/signing.md.
          //   self-hosted (default):  sign with signtool against an EV USB token (typically
          //                           on an framework-managed self-hosted GH Actions runner)
          //   cloud:                  a cloud signing provider named in cloud.provider (azure,
          //                           sslcom, digicert); no signer ships yet, the job refuses by name
          //   local:                  skip CI signing; developer signs manually on their box
          signing: {
            strategy: 'self-hosted',
            cloud:    { provider: null, options: {} },
          },
        },
        linux: {
          formats: {
            deb: {},                       // /download/linux/deb (needs brand.url + brand.contact.email)
            appimage: {},                  // /download/linux/appimage
            // Snap publishing, on by default: adds a `snap` target to the linux
            // build and publishes to the Snap Store on release. Needs
            // SNAPCRAFT_STORE_CREDENTIALS in your `.env` (the manage walk asks
            // for it; `snapcraft export-login -` mints it, then `omega deploy`
            // flows it to GH Actions), and a Linux package or release refuses
            // without it (a plain build does not).
            // `snap: false` drops it.
            snap: {
              confinement: 'strict',
              grade:       'stable',
              autoStart:   true,
              channels:    ['stable'],
            },
          },
          arch: ['x64'],                   // amd64; ia32 is essentially extinct on Linux
        },
      },
      // Auto-updater (electron-updater wrapper). Feed URL is auto-derived from `releases` (below).
      // Set `OMEGA_DEV_UPDATE=available|unavailable|error` to simulate updates in dev.
      autoUpdate: {
        enabled:        true,
        autoDownload:   true,
        startupDelayMs:      10000,      // 10s after whenReady → first check
        feedCheckIntervalMs: 3600000,    // 1h between feed polls (HTTP, keep slow)
        idleEvalIntervalMs:  60000,      // 1m idle-install evaluator (cheap, in-process)
        maxAgeMs:            2592000000, // 30d: once an update has been pending this long, force install
      },
      // Tray, menu, and context-menu are defined in JS files (full power, no DSL).
      // @omega.js/desktop looks for them at the conventional paths:
      //   src/integrations/tray/index.js
      //   src/integrations/menu/index.js
      //   src/integrations/context-menu/index.js
      // To disable at runtime: call `omega.tray.disable()` / `omega.menu.disable()` /
      // `omega.contextMenu.disable()` from your main entry. Idempotent.

      // Startup behavior: two independent knobs.
      //
      // `mode` controls how the app launches when THE USER opens it directly:
      //   normal:  main window appears, dock icon visible (typical app).
      //   hidden:  packaged builds bake LSUIElement=true into Info.plist on macOS:
      //            zero dock bounce, no dock icon, not in Cmd+Tab. Tray + notifications
      //            + networking still work. Your main.js skips windows.create() at boot
      //            and surfaces UI later (typically from a tray click). When you do call
      //            windows.create('main'), @omega.js/desktop auto-runs app.dock.show() so the dock icon
      //            appears alongside the window.
      //
      // `openAtLogin` controls auto-launch on OS login:
      //   enabled:  register the app with the OS to auto-launch (default true).
      //   mode:     `hidden` (default) means at-login launches behave like `mode: 'hidden'`;
      //             `normal` means the at-login launch shows UI like a normal launch.
      //   The login-launch mode applies ONLY when the OS launches the app. User-direct
      //   launches always use `startup.mode` above. So a "normal" app can still start
      //   hidden at login and surface only when the user explicitly opens it.
      startup: {
        mode: 'normal',
        openAtLogin: {
          enabled: true,
          mode:    'hidden',
        },
      },
      // No `windows` block needed: @omega.js/desktop no longer auto-creates windows. Your main.js
      // calls `omega.windows.create('main', { width: 1280, height: 800, ... })` when
      // you want UI to surface. Defaults baked in:
      //   main      → { width: 1024, height: 720, hideOnClose: true,  view: 'main' }
      //   any other → { width: 800,  height: 600, hideOnClose: false, view: name   }
      // Add a `windows: {}` block here only if you want to override defaults persistently.

      // Releases: the ONE public repo where built artifacts (and the auto-update feed) live.
      // The source repo can stay private; this one is always public, for unauthenticated downloads + auto-updates.
      // Nothing names it: it is always `<brand.id>-releases` under the top-level `repo.owner`, so this block is
      // a presence switch and nothing more (#883). An empty `releases: {}` addresses the repo in full.
      // `npx omega deploy`'s precheck auto-creates it if it doesn't exist (uses GH_TOKEN).
      // Artifact names carry NO version (MyApp-mac-dmg.dmg), so this repo also serves the marketing
      // site: https://github.com/<owner>/<brand.id>-releases/releases/latest/download/<asset> never changes
      // across versions, and the website derives its download buttons from it. See @omega.js/manager/docs/desktop/releasing.md.
      releases: {
        enabled: true,
      },
      // Deep links: scheme is automatically `<brand.id>://...`. Built-in routes:
      //   auth/token  → @omega.js/client auth token handoff
      //   app/show    → omega.windows.show(query.window || 'main')
      //   app/quit    → omega.quit()
      // Add custom routes at runtime: omega.deepLink.on('my-route', (ctx) => {...}) in main.
      //
      // Single-instance lock: a second launch hands its argv (and any deep link) to the
      // running copy and quits. Set false for a CLI-shaped app whose every launch is its
      // own short process; deep links and second launches then never reach a running copy.
      protocol: {
        singleInstance: true,
      },

      // "Hot config": JSON document fetched from the brand site so app behavior
      // can be flipped without shipping a new build (e.g. force-update gate, ads
      // toggle, default user agent strings, etc.). Default URL is derived as
      // `${brand.url}/data/resources/main.json` (legacy convention). Override the
      // path with `remoteConfig.url`. Polled at the same cadence as auto-updater
      // feed-check (default 1h). Disable via `enabled: false`.
      remoteConfig: {
        enabled: true,
        // url: 'https://brand.example/data/resources/main.json',   // default uses brand.url
      },
      // Restart Manager: external guardian app that relaunches this app if it
      // crashes. @omega.js/desktop talks to it over a localhost HTTP protocol (@omega.js/manager/docs/desktop/restart-manager.md):
      // auto-registers ~15s after launch, heartbeats every 60s, deregisters on clean
      // quit, and silently installs RM when missing (mac zip / win silent NSIS /
      // linux AppImage: no installer UI, no admin; RM then keeps itself updated via
      // its own standard @omega.js/desktop auto-updater). Set false to disable entirely. In dev
      // mode it's skipped unless OMEGA_RESTART_MANAGER_DEV=1.
      restartManager: {
        enabled: true,
        // feed: { owner: 'restart-manager', repo: 'update-server' },  // override for forks/mirrors
        // feed: { url: 'https://mirror.example.com/rm' },             // full base-URL override (air-gapped)
      },
    },
  },
}
